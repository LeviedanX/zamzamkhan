# Production template untuk https://zamzamkhan.com.
# Salin menjadi .env di server. Jangan commit .env atau secret nyata.

APP_NAME="PT Zam Zam Khan"
APP_ENV=production
# Wajib dibuat di server dengan: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://zamzamkhan.com
ASSET_URL=https://zamzamkhan.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Log aplikasi dan security memakai rotasi harian agar tidak tumbuh tanpa batas.
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
SECURITY_LOG_LEVEL=notice
SECURITY_LOG_DAYS=90

# Ganti sesuai credential MySQL dari hosting. Jangan gunakan akun root.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=zamzamkhan_db
DB_USERNAME=zamzamkhan_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=zamzamkhan.com
SESSION_COOKIE=zamzamkhan-session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Tidak membutuhkan worker terpisah pada shared hosting.
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=zamzamkhan_cache

# Aplikasi saat ini tidak mengirim email. Ubah ke smtp dan isi credential
# provider apabila fitur email diaktifkan.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@zamzamkhan.com"
MAIL_FROM_NAME="${APP_NAME}"

# Untuk instalasi baru, isi sementara sebelum menjalankan AdminSeeder.
# Setelah admin dibuat, kosongkan ADMIN_PASSWORD lalu jalankan config:cache ulang.
ADMIN_NAME="Administrator PT Zam Zam Khan"
ADMIN_EMAIL=
ADMIN_PASSWORD=

WEB_VISIT_RETENTION_DAYS=400
REPORT_EXPORT_RETENTION_DAYS=30

SECURITY_CSP_ENABLED=true
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_ABSOLUTE_SECONDS=28800
ADMIN_BLOCK_GAMBLING_CONTENT=true

VITE_APP_NAME="${APP_NAME}"
